# Capacitor mobile shell — dependencies + native build artifacts.
# The ios/ and android/ native projects ARE committed (generated on a Mac via
# `npx cap add`), but their build outputs are not.

node_modules/

# iOS build artifacts
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/DerivedData/
*.xcuserstate

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/

# Misc
.DS_Store
*.log
